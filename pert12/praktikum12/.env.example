# Salin menjadi .env lalu sesuaikan. Jangan commit berkas .env!
MYSQL_ROOT_PASSWORD=rahasia_root
MYSQL_DATABASE=tabungku
MYSQL_USER=tabungku
MYSQL_PASSWORD=rahasia_tabungku

# Kunci rahasia untuk menandatangani JWT. Buat sendiri, misalnya:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ganti_dengan_kunci_acak_minimal_32_karakter
# Umur token (opsional)
ACCESS_TOKEN_MENIT=15
REFRESH_TOKEN_HARI=7

# Dashboard admin (Laravel + Filament) di http://localhost:8080/admin
# APP_KEY Laravel; buat baru dengan:
#   docker compose run --rm admin php artisan key:generate --show
ADMIN_APP_KEY=base64:AOWxknIunJ7IF8weId2xT48XyGMeP8PO5qgoz61xy3w=
ADMIN_EMAIL=admin@tabungku.test
ADMIN_PASSWORD=admin12345
